# BrandNiti AI - Environment Configuration
# Copy this file to .env or configure in Streamlit secrets (.streamlit/secrets.toml)

# Optional: Google Gemini API Key for AI-assisted contextual review.
# If left blank, BrandNiti AI runs in deterministic review mode with illustrative sample review fallback.
GEMINI_API_KEY=your_gemini_api_key_here

# SQLite Database Path (Defaults to local data/brandniti.db)
BRANDNITI_DB_PATH=data/brandniti.db
